{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_CONNECTION_STRING"
  },

  "Minio": {
    "Endpoint": "localhost:9000",
    "AccessKey": "REPLACE_WITH_MINIO_ACCESS_KEY",
    "SecretKey": "REPLACE_WITH_MINIO_SECRET_KEY",
    "Bucket": "foodera-files",
    "UseSSL": false
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "Properties": {
      "Application": "FooderaERP"
    }
  },

  "Jwt": {
    "Secret": "REPLACE_WITH_JWT_SECRET_MIN_32_CHARS",
    "Issuer": "FooderaERP.Api",
    "Audience": "FooderaERP.Client",
    "ExpirationMinutes": 60,
    "RefreshExpirationMinutes": 10080
  },

  "Seed": {
    "AdminEmail": "REPLACE_WITH_ADMIN_EMAIL",
    "AdminPassword": "REPLACE_WITH_ADMIN_PASSWORD",
    "AdminFullName": "REPLACE_WITH_ADMIN_FULLNAME"
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UserName": "REPLACE_WITH_EMAIL",
    "Password": "REPLACE_WITH_EMAIL_APP_PASSWORD",
    "FromName": "FooderaERP",
    "FromEmail": "REPLACE_WITH_EMAIL",
    "UseSsl": false
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}