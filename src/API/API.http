@API_HostAddress = http://localhost:5167

GET {{API_HostAddress}}/weatherforecast/
Accept: application/json

###

# 0a. Admin login (seeded admin — see appsettings.json "Seed" section)
# Copy the accessToken from the response and paste it into @adminToken below,
# then use {{adminToken}} as a Bearer token on the requests that need it.
POST {{API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "emailOrUserName": "admin@foodera.local",
  "password": "Admin123!"
}

###

@adminToken = PASTE_ACCESS_TOKEN_HERE

# 0b. Create a test POS user (waiter) with a 4-digit Code, scoped to the seeded company (id=1, FOODERA001)
POST {{API_HostAddress}}/api/Users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Test Waiter",
  "userName": "test.waiter",
  "email": "test.waiter@foodera.local",
  "password": "Waiter123!",
  "isActive": true,
  "companyId": 1,
  "code": "0002",
  "canAccessAdminPanel": false,
  "canAccessFrontOffice": true,
  "workplaceType": 1
}

###

# 0c. Create a test POS user (manager) with an elevated Code (date-prefixed at login time)
POST {{API_HostAddress}}/api/Users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Test Manager",
  "userName": "test.manager",
  "email": "test.manager@foodera.local",
  "password": "Manager123!",
  "isActive": true,
  "companyId": 1,
  "code": "1234",
  "canAccessAdminPanel": true,
  "canAccessFrontOffice": true,
  "workplaceType": 1
}

###

# POS terminal setup: resolve CompanyCode -> companyId + restaurant list
GET {{API_HostAddress}}/api/companies/lookup/YOUR_COMPANY_CODE
Accept: application/json

###

# POS login: plain staff (Test Waiter from 0b above), 4-digit personal code
POST {{API_HostAddress}}/api/Auth/pos-login
Content-Type: application/json

{
  "companyId": 1,
  "code": "0002"
}

###

# POS login: elevated staff (Test Manager from 0c above), ddMM + 4-digit personal code.
# NOTE: the ddMM prefix must equal TODAY'S date on the server, so replace "DDMM"
# below with today's day+month (e.g. 23 Aug -> "2308") before sending.
POST {{API_HostAddress}}/api/Auth/pos-login
Content-Type: application/json

{
  "companyId": 1,
  "code": "DDMM1234"
}

###

# POS login: RFID card scan (set a RfidCardId on a user via PUT /api/Users/{id} first)
POST {{API_HostAddress}}/api/Auth/pos-login
Content-Type: application/json

{
  "companyId": 1,
  "rfidCardId": "YOUR_RFID_CARD_ID"
}

###

# Company settings: get current company's settings (auto-creates default row on first call)
GET {{API_HostAddress}}/api/company-settings
Authorization: Bearer {{adminToken}}

###

# Company settings: update
PUT {{API_HostAddress}}/api/company-settings
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "openingTime": "09:00:00",
  "moduleFilial": true,
  "modulePaket": false,
  "moduleOtel": false,
  "moduleAnbar": true,
  "moduleFitnes": false,
  "moduleRezervasyon": true,
  "moduleDataSecimi": false,
  "moduleMasaBolge": true,
  "moduleQiymetSor": false,
  "integrationWolt": false,
  "integrationBolt": false,
  "integration189Delivery": false,
  "alertMilliseconds": 500,
  "alertRingCount": 3,
  "alertRingIntervalSeconds": 5,
  "loginLogoUrl": null,
  "reportLogoUrl": null,
  "wallpaperUrl": null,
  "loginLocation": null,
  "transparencyLevel": 80,
  "productColor": "#0b3d2e",
  "floorLabel": null,
  "slogan": "Bizi seçdiyiniz üçün təşəkkür edirik",
  "socialLinks": null,
  "contactPhoneNumber": "+994501234567",
  "receiptFontSize": 12,
  "categoryFontSize": 14,
  "allowReceiptEditAfterPrint": true,
  "waiterCanPrintCustomerReceipt": true
}

