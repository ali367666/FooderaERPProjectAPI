# Foodera Local installation settings — copy to ".env" and fill in. Keep .env private.

# This computer's address on the restaurant network (terminals open http://SERVER_IP:3000).
SERVER_IP=192.168.1.10

# Strong passwords (min. 8 chars, upper + lower + digit + symbol for SQL Server).
DB_PASSWORD=ChangeMe_Db_2026!
MINIO_USER=foodera
MINIO_PASSWORD=ChangeMe_Files_2026!

# Random string, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Platform public key (the "Licensing:PublicKeyPem" printed by --generate-license-keypair).
# Put it on ONE line with \n in place of line breaks, inside double quotes.
LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Platform admin account created on first start (used to create the restaurant's company).
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_Admin_2026!
ADMIN_FULLNAME=Foodera Admin
