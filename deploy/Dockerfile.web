# Foodera web app (panel + POS) — build context: repository root.
FROM node:20-alpine AS build
WORKDIR /app
COPY FrontEndCode/package.json FrontEndCode/package-lock.json ./
RUN npm ci
COPY FrontEndCode/ ./
# {host} is replaced in the browser by the address the app was opened with, so the server PC
# (localhost) and every terminal on the network (server's LAN IP) reach the API alike.
ARG NEXT_PUBLIC_API_URL=http://{host}:5167/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
